    });
    input.addEventListener('keydown', function (e) { if (e.key === 'Escape') { closeInput(); ask.resume(); } });
    /* start cycling after the first prompt has been readable; pause off-screen */
    var started = false;
    var io = new IntersectionObserver(function (en) {
      if (en[0].isIntersecting) { if (!started && cycling) { started = true; timer = setTimeout(function () { i = 1; run(); }, 3500); } }
      else if (started && cycling) { clearTimeout(timer); clearTimeout(typing); started = false; show(CG_PROMPTS[i]); }
    });

    .hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.75rem; }
    .hero-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2rem; }
    .stat-chip { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--r-md); padding: 1.25rem 1rem; transition: border-color 0.25s; display: flex; flex-direction: column; }
    .stat-chip:hover { border-color: var(--border-a); }
    .stat-chip-val { font-family: var(--ff-display); font-size: 1.65rem; font-weight: 800; background: var(--grad-text); -webkit-background-clip: text; -webkit-text-fill-color: transparent; line-height: 1.1; }
    .stat-chip-lbl { font-size: 0.74rem; color: var(--text-3); margin-top: 0.35rem; line-height: 1.4; }
    .hero-updated { font-size: 0.7rem; color: var(--text-3); margin-top: 0.6rem; letter-spacing: 0.01em; }
    .hero-press { display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap; margin-top: 1.25rem; font-size: 0.83rem; color: var(--text-2); line-height: 1.6; }
    .hero-press-tag { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; color: var(--text-3); }
    .hero-press a { color: var(--accent-3); font-weight: 600; text-decoration: none; }
    .hero-press a:hover { text-decoration: underline; }
    .hero-right { display: flex; justify-content: center; align-items: center; position: relative; }
    /* faint grid behind the graph, fading out toward the text column */
    .hero-right::before { content: ''; position: absolute; inset: -6% -4%; pointer-events: none;
      background-image: linear-gradient(rgba(147,197,253,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(147,197,253,0.07) 1px, transparent 1px);
      background-size: 34px 34px;
      -webkit-mask-image: radial-gradient(ellipse 55% 60% at 50% 45%, #000 20%, transparent 72%); mask-image: radial-gradient(ellipse 55% 60% at 50% 45%, #000 20%, transparent 72%); }

    /* ── citation graph: Khadija in the centre, the engines that cite her around her ── */
    .cg { position: relative; width: 100%; max-width: 540px; aspect-ratio: 560 / 540; }
    .cg svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
    .cg-photo { position: absolute; left: 50%; top: 44.4%; width: 32.9%; height: auto; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; object-fit: cover; object-position: center top;
      border: 2px solid rgba(59,130,246,0.45); box-shadow: 0 0 0 10px rgba(59,130,246,0.06), 0 0 60px rgba(59,130,246,0.25), 0 24px 64px rgba(0,0,0,0.5); z-index: 1; }
    .cg-glow { fill: rgba(59,130,246,0.12); }
    .cg-ring { fill: none; stroke: rgba(59,130,246,0.35); stroke-width: 2; }
    .cg-out { stroke: var(--accent); stroke-width: 1.6; fill: none; stroke-dasharray: 5 6; opacity: 0.75; animation: cg-dash 1.1s linear infinite; }
    .cg-back { stroke: var(--accent-2); stroke-width: 1.4; fill: none; opacity: 0.5; }
    .cg-faint { stroke: var(--border-a); stroke-width: 1; fill: none; stroke-dasharray: 2 5; }
    @keyframes cg-dash { to { stroke-dashoffset: -22; } }
    .cg-node { cursor: default; }
    .cg-node rect { fill: var(--bg-card); stroke: var(--border-a); stroke-width: 1.2; transition: stroke 0.2s, fill 0.2s; }
    .cg-node:hover rect { stroke: var(--accent-2); fill: var(--bg-card-h); }
    .cg-node text { font-family: var(--ff-display); font-weight: 700; font-size: 14px; fill: var(--text-1); }
    .cg-node.cg-hex polygon { fill: var(--bg-card); stroke: rgba(59,130,246,0.5); stroke-width: 1.2; }
    .cg-node.cg-hex text { font-family: var(--ff-body); font-weight: 600; font-size: 8.5px; fill: var(--accent-3); letter-spacing: 0.04em; }

    /* the prompt bar: a real question, answered with the entity that cites her */
    .cg-prompt { position: absolute; left: 50%; bottom: -2%; transform: translateX(-50%); width: 74%; min-width: 300px; z-index: 2; color: #0B1220; border-radius: 20px; padding: 0.85rem 1rem 0.7rem;
      box-shadow: 0 20px 50px rgba(0,0,0,0.55); border: 3px solid transparent;
      background: linear-gradient(#fff, #fff) padding-box, conic-gradient(from 200deg, #22C55E, #F59E0B, #EC4899, #3B82F6, #22C55E) border-box; }
    .cg-q { font-family: var(--ff-display); font-weight: 500; font-size: 1.1rem; line-height: 1.35; min-height: 2.95rem; color: #0B1220; }
    .cg-caret { display: inline-block; width: 2px; height: 1.05em; background: #0B1220; vertical-align: -0.15em; margin-left: 2px; animation: cg-blink 1s steps(1) infinite; }
    @keyframes cg-blink { 50% { opacity: 0; } }
    .cg-chip { display: inline-flex; align-items: center; gap: 6px; background: var(--accent); color: #fff; border-radius: 6px; padding: 2px 8px; font-family: var(--ff-body); font-weight: 600; font-size: 0.8rem; text-decoration: none; vertical-align: 1px; white-space: nowrap; }
    .cg-chip:hover, .cg-chip:focus-visible { background: #1D4ED8; }
    .cg-chip::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent-3); }
    .cg-bar { display: flex; align-items: center; justify-content: space-between; margin-top: 0.4rem; color: #64748B; font-size: 0.8rem; }
    .cg-send { width: 28px; height: 28px; border-radius: 50%; background: var(--accent); display: grid; place-items: center; color: #fff; font-size: 0.9rem; }
    .cg-src { font-size: 0.68rem; color: #64748B; margin-top: 0.3rem; min-height: 1em; }
    .cg-src a { color: #2563EB; }
    .cg-input { display: block; width: 100%; font-family: var(--ff-display); font-weight: 500; font-size: 1.1rem; line-height: 1.35; min-height: 2.95rem; color: #0B1220; background: transparent; border: 0; outline: 0; padding: 0; }
    .cg-input::placeholder { color: #94A3B8; }
    .cg-input[hidden], .cg-q[hidden] { display: none; }   /* author display rules would otherwise beat the hidden attribute */
    .cg-ask { background: none; border: 0; padding: 0.35rem 0; color: #64748B; font: 600 0.78rem var(--ff-body); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; min-height: 40px; }
    .cg-ask:hover, .cg-ask:focus-visible { color: #0B1220; }
    .cg-send { border: 0; cursor: pointer; }
    .cg-send:focus-visible { outline: 2px solid #0B1220; outline-offset: 2px; }
    .cg-prompt:focus-within { box-shadow: 0 20px 50px rgba(0,0,0,0.55), 0 0 0 4px rgba(56,189,248,0.35); }
    /* hover or click a node: its lines stay lit, the rest fade */
    .cg-node { cursor: pointer; transition: opacity 0.25s; }
    .cg-out, .cg-back, .cg-faint { transition: opacity 0.25s; }
    .cg-focus .cg-out:not(.on), .cg-focus .cg-back:not(.on), .cg-focus .cg-faint:not(.on) { opacity: 0.1; }
    .cg-focus .cg-node:not(.on) { opacity: 0.35; }
    .cg-node.on rect, .cg-node.on polygon { stroke: var(--accent-2); }

    @media (prefers-reduced-motion: reduce) { .cg-out, .cg-caret { animation: none; } }

    /* ── mobile fallback: same graph collapsed to one axis ── */
    .cg-mobile { display: none; }
    .sec-orb-1, .sec-orb-2, .sec-orb-3 { animation: float-slow 15s ease-in-out infinite; }
    @media (max-width: 1024px) {
      /* minmax(0,1fr): a plain 1fr track grows to the content's min-content width, and
         Chromium sizes a wrapping flex row (the engine chips) as if it were one line,
         which pushed the whole hero past the viewport on phones. */
      .hero-grid { grid-template-columns: minmax(0, 1fr); }
      .hero-right { margin-top: 2.5rem; min-width: 0; }
      .cg { max-width: 480px; }
    }
    @media (max-width: 768px) {
      .hero { padding: 88px 5% 60px; }
      .hero h1 { font-size: 2.1rem; }
      .hero-right { order: -1; margin: 0 0 1.75rem; }
      .hero-right::before { -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 72%); mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 72%); }
      .cg { display: none; }
      .cg-mobile { display: block; width: 100%; position: relative; }
      .cg-m-photo { width: 132px; height: 132px; border-radius: 50%; object-fit: cover; object-position: center top; display: block; margin: 0 auto;
        border: 2px solid rgba(59,130,246,0.45); box-shadow: 0 0 0 8px rgba(59,130,246,0.07), 0 0 40px rgba(59,130,246,0.22); }
      .cg-m-spokes { display: flex; justify-content: center; gap: 10px; margin-top: 6px; }
      .cg-m-spokes i { width: 1px; height: 18px; background: var(--border-a); display: block; }
      .cg-m-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; list-style: none; }
      .cg-m-chips li { font-family: var(--ff-display); font-size: 0.72rem; font-weight: 700; color: var(--text-1); background: var(--bg-card); border: 1px solid var(--border-a); border-radius: 100px; padding: 5px 11px; }
      .cg-m-prompt { margin: 1rem auto 0; max-width: 420px; color: #0B1220; border-radius: 16px; padding: 0.65rem 0.8rem; border: 2px solid transparent;
        background: linear-gradient(#fff, #fff) padding-box, conic-gradient(from 200deg, #22C55E, #F59E0B, #EC4899, #3B82F6, #22C55E) border-box; }
      .cg-m-prompt p { font-family: var(--ff-display); font-weight: 500; font-size: 0.95rem; line-height: 1.35; color: #0B1220; }
      .cg-m-prompt .cg-chip { font-size: 0.7rem; padding: 1px 7px; }
      .cg-m-form { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
      .cg-m-form input { flex: 1; min-width: 0; font: 500 0.9rem var(--ff-display); color: #0B1220; background: #F1F5F9; border: 1px solid #CBD5E1; border-radius: 8px; padding: 0.45rem 0.6rem; }
      .cg-m-form button { border: 0; border-radius: 8px; background: var(--accent); color: #fff; font: 700 0.8rem var(--ff-body); padding: 0 0.8rem; min-height: 40px; cursor: pointer; }
    }
  </style>
</head>

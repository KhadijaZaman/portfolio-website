  <style>
    /* home-specific hero styling */
    .hero { min-height: 100vh; display: flex; align-items: center; padding: 100px 6% 80px; position: relative; overflow: hidden; }
    .hero-orb-1 { position: absolute; top: -25%; right: -15%; width: 900px; height: 900px; border-radius: 50%; background: radial-gradient(circle, rgba(59,130,246,0.10) 0%, transparent 65%); pointer-events: none; animation: float-slow 10s ease-in-out infinite; }

{% raw %}
<script>
/* ── Hero citation graph + question box (self-contained, no CDN) ──
   CG_ENGINES / CG_STACK draw the graph; each entry carries the prompt shown
   when the visitor clicks it. Every chip links to a real page, never a claim.
   The question box matches what the visitor types against the site index
   emitted in #cg-data (tools, posts, case studies, pages). No model, no
   network: it is a guide to the site, and says so. */
(function () {
  var data = {};
  try { data = JSON.parse(document.getElementById('cg-data').textContent); } catch (e) {}
  var LIVE = data.live || {}, FMT = data.fmt || {}, INDEX = data.index || [];
  var gsc = LIVE.gsc || {}, llm = LIVE.llm || {};

  var CG_ENGINES = [
    { label: 'Google',       angle: -140, r: 205, prompt: { q: 'What does Search Engine Land recommend for topic clusters? ', chip: 'Search Engine Land guide', href: 'https://searchengineland.com/guide/topic-clusters-for-ai-search', src: 'The guide runs on the Query Fan-Out Generator I built' } },
    { label: 'ChatGPT',      angle:  -40, r: 205, prompt: { q: 'How do I get my brand cited by ChatGPT? ', chip: 'Read the checklist', href: '/blog/get-cited-by-ai-search/', src: 'The retrieval-readiness checklist I use' } },
    { label: 'Gemini',       angle:    5, r: 220, prompt: { q: 'Why does ranking #1 not mean Gemini cites you? ', chip: 'SEO vs AEO vs GEO', href: '/blog/geo-aeo-vs-seo/', src: 'Where the three layers diverge, and how to sequence them' } },
    { label: 'Perplexity',   angle:   45, r: 205, prompt: { q: 'How do you measure citations in Perplexity? ', chip: 'Breaking my own study', href: '/blog/breaking-my-own-study/', src: 'A cross-engine citation study, rebuilt and tested against a null' } },
    { label: 'AI Overviews', angle:  165, r: 210, prompt: { q: 'Why did clicks fall while rankings recovered? ', chip: 'Core update recovery', href: '/work/core-update-recovery/', src: 'Position 32 back to 8.2, with AI Overview absorption flagged as an inference' } }
  ];
  /* nearest: index into CG_ENGINES the faint line runs to */
  var CG_STACK = [
    { label: 'GSC',    angle: -100, r: 262, nearest: 0, prompt: { q: 'How do you verify search growth? ', chip: 'Wellows case study', href: '/work/wellows-ai-visibility/', src: 'Search Console · ' + FMT.impressions + ' impressions, ' + (gsc.window || '3 months vs the previous 3') + ', avg. position ' + gsc.avgPositionBefore + ' → ' + gsc.avgPosition } },
    { label: 'GA4',    angle:  -20, r: 275, nearest: 1, prompt: { q: 'How do you track LLM referral traffic? ', chip: (llm.wellows || {}).multiplier + '× in ' + ((llm.wellows || {}).window || '8 months'), href: '/work/wellows-ai-visibility/', src: 'GA4 · Wellows LLM referral sessions from ' + (llm.wellows || {}).baseline + '/month, ' + (llm.wellows || {}).multiplier + '× over ' + ((llm.wellows || {}).window || '8 months') + ', $0 paid' } },
    { label: 'n8n',    angle:   28, r: 272, nearest: 2, prompt: { q: 'How do you automate SEO reporting? ', chip: 'Marketing automation', href: '/#expertise', src: 'n8n and LLM workflows wired into GA4 reporting, so the numbers arrive without anyone exporting them.' } },
    { label: 'Ahrefs', angle:  200, r: 262, nearest: 4, prompt: { q: 'How do you audit a site that lost 70% of its clicks? ', chip: 'Five workstreams, one owner', href: '/work/core-update-recovery/', src: 'Technical, semantic, topical authority, internal links, third-party mentions' } },
    { label: 'Looker', angle:  150, r: 262, nearest: 4, prompt: { q: 'Where do the dashboards live? ', chip: 'GA4 + Looker reporting', href: '/work/wellows-ai-visibility/', src: 'Sources on every case study: GA4, Looker Studio, Search Console' } }
  ];
  var CG_PROMPTS = [
    { q: 'How do I structure topic clusters for AI search? ', chip: 'Search Engine Land guide', href: 'https://searchengineland.com/guide/topic-clusters-for-ai-search', src: 'The guide runs on the Query Fan-Out Generator I built' },
    { q: 'What is query fan-out and how do I use it? ', chip: 'Query Fan-Out Generator', href: '/tools/#tool-query-fan-out', src: 'Built on Google’s query fan-out patent' + (FMT.queryFanOut ? ' · ' + FMT.queryFanOut + ' active users' : '') },
    { q: 'How do I research entities for LLM visibility? ', chip: 'LLM Query Builder', href: '/tools/#tool-llm-query-builder', src: 'Built for practitioners who work with AI retrieval systematically' }
  ];

  var svg = document.getElementById('cg-svg'); if (!svg) return;
  var NS = 'http://www.w3.org/2000/svg';
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var C = { x: 280, y: 240 };
  var edges = document.getElementById('cg-edges'), nodes = document.getElementById('cg-nodes');

  function el(tag, attrs, parent) { var e = document.createElementNS(NS, tag); for (var k in attrs) e.setAttribute(k, attrs[k]); if (parent) parent.appendChild(e); return e; }
  function text(parent, x, y, str, cls) { var t = el('text', { x: x, y: y, 'text-anchor': 'middle', 'dominant-baseline': 'middle' }, parent); if (cls) t.setAttribute('class', cls); t.textContent = str; return t; }
  function pt(angle, r) { var a = angle * Math.PI / 180; return { x: C.x + Math.cos(a) * r, y: C.y + Math.sin(a) * r }; }
  var enginePts = CG_ENGINES.map(function (n) { return pt(n.angle, n.r); });
  var allNodes = [];   /* { g, edges:[], prompt } */

  /* highlight: a node and its lines stay lit, everything else fades */
  var pinned = null;
  function highlight(node) {
    var on = node || pinned;
    svg.classList.toggle('cg-focus', !!on);
    allNodes.forEach(function (n) {
      var hit = n === on;
      n.g.classList.toggle('on', hit);
      n.edges.forEach(function (e) { e.classList.toggle('on', hit); });
    });
  }
  function wire(node) {
    node.g.addEventListener('mouseenter', function () { highlight(node); });
    node.g.addEventListener('mouseleave', function () { highlight(null); });
    node.g.addEventListener('click', function () { pinned = (pinned === node) ? null : node; highlight(null); if (pinned) ask.showPrompt(node.prompt, true); else ask.resume(); });
  }

  CG_ENGINES.forEach(function (n, i) {
    var p = enginePts[i], own = [];
    /* dashed line out (the query fanning out), curved line back (the citation returning) */
    own.push(el('path', { d: 'M' + C.x + ' ' + C.y + ' L' + p.x + ' ' + p.y, 'class': 'cg-out' }, edges));
    var mid = { x: (C.x + p.x) / 2 + (p.y - C.y) * 0.18, y: (C.y + p.y) / 2 - (p.x - C.x) * 0.18 };
    var back = el('path', { id: 'cg-back-' + i, d: 'M' + p.x + ' ' + p.y + ' Q' + mid.x + ' ' + mid.y + ' ' + C.x + ' ' + C.y, 'class': 'cg-back' }, edges);
    own.push(back);
    if (!reduce) {
      var dot = el('circle', { r: 3, fill: '#38BDF8' }, edges);
      var motion = el('animateMotion', { dur: (2.4 + i * 0.35) + 's', repeatCount: 'indefinite', begin: (-i * 0.7) + 's' }, dot);
      el('mpath', { href: '#' + back.id }, motion);
    }
    var w = n.label.length * 8.6 + 44, h = 38;
    var g = el('g', { 'class': 'cg-node' }, nodes);   /* pointer-only: the SVG is aria-hidden; the question box covers keyboard users */
    el('title', {}, g).textContent = n.prompt.q.trim();
    el('rect', { x: p.x - w / 2, y: p.y - h / 2, width: w, height: h, rx: 11 }, g);
    el('circle', { cx: p.x - w / 2 + 18, cy: p.y, r: 5, fill: '#38BDF8' }, g);
    text(g, p.x + 9, p.y + 1, n.label);
    var node = { g: g, edges: own, prompt: n.prompt, label: n.label }; allNodes.push(node); wire(node);
  });

  CG_STACK.forEach(function (n) {
    var p = pt(n.angle, n.r), q = enginePts[n.nearest];
    var faint = el('path', { d: 'M' + q.x + ' ' + q.y + ' L' + p.x + ' ' + p.y, 'class': 'cg-faint' }, edges);
    var g = el('g', { 'class': 'cg-node cg-hex' }, nodes);
    el('title', {}, g).textContent = n.prompt.q.trim();
    var pts = [];
    for (var k = 0; k < 6; k++) { var a = (60 * k - 30) * Math.PI / 180; pts.push((p.x + Math.cos(a) * 17).toFixed(1) + ',' + (p.y + Math.sin(a) * 17).toFixed(1)); }

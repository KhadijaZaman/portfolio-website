    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.25} }
    .hero h1 { font-family: var(--ff-display); font-size: clamp(2.4rem, 4.5vw, 4rem); font-weight: 800; line-height: 1.08; letter-spacing: -0.03em; margin-bottom: 1.25rem; }

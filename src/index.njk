  }
  sectionCanvas('exp-3d','expertise',[
    {geo:icosa(85),col:'#60A5FA',al:0.45,nx:0.35,ny:-0.15,spd:[0.002,0.004,0.001]},
    {geo:icosa(65),col:'#38BDF8',al:0.40,nx:-0.30,ny:0.20,spd:[-0.003,0.003,0.004]},
    {geo:icosa(50),col:'#38BDF8',al:0.35,nx:0.15,ny:0.35,spd:[0.003,-0.002,0.003]}
  ]);
  sectionCanvas('cases-3d','work',[
    {geo:icosa(95),col:'#3B82F6',al:0.48,nx:0.25,ny:-0.20,spd:[0.0025,0.0045,0.0015]},
    {geo:icosa(70),col:'#60A5FA',al:0.42,nx:-0.35,ny:0.15,spd:[-0.0035,0.0035,0.0045]},
    {geo:icosa(55),col:'#38BDF8',al:0.38,nx:0.20,ny:0.30,spd:[0.0028,-0.0025,0.0035]}
  ]);
})();
</script>

    var node = { g: g, edges: [faint], prompt: n.prompt, label: n.label }; allNodes.push(node); wire(node);
  });

  /* ── question box: match the visitor's words to a page on this site ── */
  var STOP = /^(the|a|an|and|or|of|to|in|on|for|is|are|do|does|did|how|what|why|who|which|where|when|i|my|me|you|your|can|with|about|it|this|that|get|be|by|from|any|some|help|need|want|tell|show|please)$/;
  function tokens(str) { return String(str || '').toLowerCase().replace(/[^a-z0-9#×\s-]/g, ' ').split(/\s+/).filter(function (w) { return w.length > 1 && !STOP.test(w); }); }
  function stem(w) { return w.replace(/(ies|ing|ed|s)$/, function (m) { return m === 'ies' ? 'y' : ''; }); }
  function search(query) {
    var qs = tokens(query).map(stem); if (!qs.length) return null;
    var best = null, bestScore = 0;
    /* engine and stack nodes answer by name */
    allNodes.forEach(function (n) { var l = n.label.toLowerCase().replace(/\s/g, ''); if (query.toLowerCase().replace(/\s/g, '').indexOf(l) !== -1) { if (4 > bestScore) { bestScore = 4; best = { prompt: n.prompt, node: n }; } } });
    INDEX.forEach(function (e) {
      var tt = tokens(e.t).map(stem), kk = tokens(e.k).map(stem), dd = tokens(e.d).map(stem), score = 0;
      qs.forEach(function (w) { if (tt.indexOf(w) !== -1) score += 3; else if (kk.indexOf(w) !== -1) score += 2; else if (dd.indexOf(w) !== -1) score += 1; });

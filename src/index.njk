    @keyframes float-med { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-16px)} }
    .hero-grid { max-width: 1240px; margin: 0 auto; width: 100%; display: grid; grid-template-columns: 1fr 540px; gap: 1.5rem; align-items: center; position: relative; z-index: 1; }
    .avail-badge { display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(59,130,246,0.08); border: 1px solid rgba(59,130,246,0.25); border-radius: 100px; padding: 0.35rem 1rem; font-size: 0.78rem; font-weight: 500; color: #93C5FD; margin-bottom: 1.25rem; }

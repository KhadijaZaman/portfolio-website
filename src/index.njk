  }

  var q = document.getElementById('cg-q'), src = document.getElementById('cg-src');
  var form = document.getElementById('cg-form'), input = document.getElementById('cg-input'), askBtn = document.getElementById('cg-ask'), qwrap = document.getElementById('cg-qwrap');
  function chip(p) { var a = document.createElement('a'); a.className = 'cg-chip'; a.href = p.href; a.textContent = p.chip; if (p.href.charAt(0) !== '/') { a.target = '_blank'; a.rel = 'noopener'; } return a; }
  function render(target, srcEl, p) { target.textContent = p.q; target.appendChild(chip(p)); if (srcEl) srcEl.textContent = p.src || ''; }
  function answerFor(query) {
    var hit = search(query), trimmed = query.trim().replace(/\?+$/, '');
    if (hit && hit.prompt) { pinned = hit.node; highlight(null); return { q: trimmed + '? ', chip: hit.prompt.chip, href: hit.prompt.href, src: hit.prompt.src }; }
    if (hit && hit.entry) { var e = hit.entry; return { q: trimmed + '? ', chip: e.t, href: e.u, src: e.g + ' · ' + e.d }; }
    return { q: trimmed + '? ', chip: 'Ask me directly', href: '/contact/', src: 'Nothing on this site answers that yet. I reply within 48 hours.' };
  }

  var ask = { showPrompt: function () {}, resume: function () {} };
  if (q && form && input) {
    var i = 0, timer, cycling = true, typing = null;
    function stop() { clearTimeout(timer); clearTimeout(typing); cycling = false; }
    function show(p) { render(q, src, p); }
    function typeThen(p, done) {
      var n = 0; src.textContent = ''; clearTimeout(typing);
      (function step() { if (n <= p.q.length) { q.textContent = p.q.slice(0, n); n++; typing = setTimeout(step, reduce ? 0 : 34); } else { show(p); if (done) done(); } })();
    }
    function run() { if (!cycling) return; typeThen(CG_PROMPTS[i], function () { timer = setTimeout(function () { i = (i + 1) % CG_PROMPTS.length; run(); }, 4200); }); }
    ask.showPrompt = function (p) { stop(); input.hidden = true; qwrap.hidden = false; askBtn.textContent = 'Ask your own question'; typeThen(p); };
    ask.resume = function () { if (cycling || reduce) return; cycling = true; run(); };
    function openInput() { stop(); pinned = null; highlight(null); qwrap.hidden = true; input.hidden = false; input.value = ''; src.textContent = 'A guide to this site, not an AI. Type a topic, a tool, or an engine name.'; askBtn.textContent = 'Back to examples'; input.focus(); }
    function closeInput() { input.hidden = true; qwrap.hidden = false; askBtn.textContent = 'Ask your own question'; }
    askBtn.addEventListener('click', function () { if (input.hidden) openInput(); else { closeInput(); ask.resume(); } });
    qwrap.addEventListener('click', function (e) { if (e.target.closest('a')) return; openInput(); });
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (input.hidden) { openInput(); return; }
      var v = input.value.trim(); if (!v) { input.focus(); return; }

---
layout: base.njk
ogType: article
---
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": (date | isoDate),
  "author": { "@type": "Person", "name": "Khadija Zaman", "url": site.url + "/" },
  "publisher": { "@type": "Person", "name": "Khadija Zaman" },
  "mainEntityOfPage": site.url + page.url,
  "image": site.url + "/web-app-manifest-512x512.png"
} | dump | safe }}</script>
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": site.url + "/blog/" },
    { "@type": "ListItem", "position": 3, "name": title, "item": site.url + page.url }
  ]
} | dump | safe }}</script>

<header class="page-hero">
  <div class="page-hero-orb" aria-hidden="true"></div>
  <div class="wrap" style="max-width:760px;">
    <nav class="crumbs reveal" aria-label="Breadcrumb"><a href="/">Home</a> <span>/</span> <a href="/blog/">Blog</a> <span>/</span> {{ title }}</nav>
    <div class="post-meta reveal"><span class="post-cat">{{ category }}</span><span class="post-date">{{ date | readableDate }} · {{ readTime }} read · by Khadija Zaman</span></div>
    <h1 class="reveal d1">{{ title }}</h1>
  </div>
</header>

{% set toc = content | tocFromHtml %}
<article aria-label="Article">
  <div class="wrap post-layout{% if toc.length < 2 %} post-layout--no-toc{% endif %}">
    {%- if toc.length > 1 %}
    <aside class="toc" id="toc" aria-label="Table of contents">
      <div class="toc-title">In this article</div>
      <ul id="toc-list">
        {%- for h in toc %}
        <li><a href="#{{ h.id }}">{{ h.text }}</a></li>
        {%- endfor %}
      </ul>
    </aside>
    {%- endif %}

    <div class="prose">
      {% if starter %}
      <div class="draft-note">
        <span aria-hidden="true">✎</span>
        <div><strong>Starter draft.</strong> This is a seeded post to show the article template. Swap in your own analysis, data, and examples before publishing.</div>
      </div>
      {% endif %}
      {{ content | safe }}

      <!-- Author bio -->
      <div class="author-box">
        <img class="author-avatar" src="/static/img/khadija-avatar.webp" alt="Khadija Zaman" width="72" height="72" loading="lazy">
        <div class="author-meta">
          <div class="author-name">Khadija Zaman</div>
          <p>SEO &amp; GEO/AEO specialist and Marketing Manager at Wellows — I get brands ranked on Google and cited by ChatGPT, Gemini, and Perplexity, then automate the execution.</p>
          <div class="author-links">
            <a href="/about/">More about me →</a>
            <a href="{{ site.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
            <a href="{{ site.github }}" target="_blank" rel="noopener">GitHub</a>
            <a href="/contact/">Work together</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Read next -->
  {% set nextPosts = collections.posts | relatedByCategory(page.url, category) | limit(2) %}
  {% if nextPosts.length %}
  <div class="wrap read-next">
    <h2 class="read-next-title">Read next</h2>
    <div class="post-grid">
      {% for post in nextPosts %}
      <a class="post-card" href="{{ post.url }}">
        <div class="post-meta"><span class="post-cat">{{ post.data.category }}</span><span class="post-date">{{ post.data.date | readableDate }} · {{ post.data.readTime }}</span></div>
        <h3>{{ post.data.title }}</h3>
        <p>{{ post.data.description }}</p>
        <span class="post-more">Read the post →</span>
      </a>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</article>

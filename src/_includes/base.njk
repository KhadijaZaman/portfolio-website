<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <script>document.documentElement.classList.add('js');</script>
  <noscript><style>.reveal{opacity:1 !important;transform:none !important;}</style></noscript>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if metaTitle %}{{ metaTitle }}{% else %}{{ title }} — Khadija Zaman{% endif %}</title>
  <meta name="description" content="{{ description }}">
{%- if noindex %}
  <meta name="robots" content="noindex">
{%- endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="Khadija Zaman">
  <meta property="og:title" content="{% if metaTitle %}{{ metaTitle }}{% else %}{{ title }} — Khadija Zaman{% endif %}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:image" content="{{ site.url }}/og-image.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if metaTitle %}{{ metaTitle }}{% else %}{{ title }} — Khadija Zaman{% endif %}">
  <meta name="twitter:description" content="{{ description }}">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="alternate" type="application/rss+xml" title="Khadija Zaman — Blog" href="/feed.xml">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Bricolage+Grotesque:opsz,wght@12..60,400;12..60,500;12..60,600;12..60,700;12..60,800&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Bricolage+Grotesque:opsz,wght@12..60,400;12..60,500;12..60,600;12..60,700;12..60,800&display=swap"></noscript>
  <link rel="stylesheet" href="/css/main.css">

  {#- The one Person entity every page's author/publisher points at by @id.
      The hand-built HTML pages carry an identical copy in their own head. -#}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": site.url + "/#person",
    "name": "Khadija Zaman",
    "url": site.url + "/",
    "image": site.url + "/apple-touch-icon.png",
    "description": "Khadija Zaman is AI Search Manager at Wellows, a Disrupt.com company, based in Karachi, Pakistan.",
    "disambiguatingDescription": "In search since 2019, she has owned SEO, content and AI-search (GEO/AEO) programs in-house at Wellows since 2023 and builds SEO tooling grounded in Google patent research used by 1,647 practitioners.",
    "jobTitle": "AI Search Manager",
    "worksFor": { "@type": "Organization", "name": "Wellows", "url": "https://wellows.com/", "parentOrganization": { "@type": "Organization", "name": "Disrupt.com", "url": "https://disrupt.com/" } },
    "address": { "@type": "PostalAddress", "addressLocality": "Karachi", "addressCountry": "PK" },
    "email": "mailto:" + site.authorEmail,
    "sameAs": [site.linkedin, site.github, "https://www.allaboutai.com/author/khadija-zaman/"],
    "knowsAbout": ["Search Engine Optimization", "Generative Engine Optimization", "Answer Engine Optimization", "Semantic SEO", "Query Fan-Out", "Content Strategy", "Marketing Automation"]
  } | dump | safe }}</script>
</head>
<body>

<a class="skip-nav" href="#main-content">Skip to main content</a>

<nav aria-label="Main navigation">
  <a href="/" class="nav-logo">Khadija Zaman</a>
  <ul class="nav-links" id="nav-links">
    {#- `section` marks which nav item is current. Defaults to "blog" because
        every page that used this layout was a blog page before case studies
        joined; case-study.njk sets section: work. -#}
    {%- set nav = section or "blog" %}
    <li><a href="/about/"{% if nav == "about" %} class="active"{% endif %}>About</a></li>
    <li><a href="/work/"{% if nav == "work" %} class="active"{% endif %}>Work</a></li>
    <li><a href="/blog/"{% if nav == "blog" %} class="active"{% endif %}>Blog</a></li>
    <li><a href="/tools/"{% if nav == "tools" %} class="active"{% endif %}>Tools</a></li><li><a href="/cv/"{% if nav == "cv" %} class="active"{% endif %}>CV</a></li>
    <li><a href="/contact/" class="nav-cta">Work Together →</a></li>
  </ul>
  <button type="button" class="nav-toggle" id="nav-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="nav-links"><span></span><span></span><span></span></button>
</nav>

<main id="main-content">
{{ content | safe }}
</main>

<section class="newsletter" aria-label="Newsletter">
  <div class="newsletter-glow" aria-hidden="true"></div>
  <div class="newsletter-inner">
    <div class="sec-tag reveal" style="justify-content:center;">The Newsletter</div>
    <h2 class="reveal d1">New posts, straight to your inbox</h2>
    <p class="reveal d2">Practical notes on SEO and AI search, delivered when each post goes live. No fluff, no sales pitch.</p>
    <form class="newsletter-form reveal d2" id="newsletter-form">
      <label class="hp-field" aria-hidden="true"><input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off"></label>
      <input type="email" name="email" placeholder="you@company.com" aria-label="Email address" required>
      <button type="submit">Subscribe →</button>
    </form>
    <div class="newsletter-note reveal d3">Unsubscribe anytime.</div>
  </div>
</section>

<footer>
  <div class="footer-in">
    <div class="footer-brand"><a href="/" class="nav-logo">Khadija Zaman</a><p>AI Search Manager at Wellows, a Disrupt.com company. Semantic SEO, content strategy and marketing automation, run as one system. Karachi, Pakistan.</p></div>
    <div class="footer-cols">
      <div class="footer-col"><h5>Site</h5><a href="/about/">About</a><a href="/cv/">CV</a><a href="/blog/">Blog</a><a href="/tools/">Tools</a><a href="/contact/">Contact</a></div>
      <div class="footer-col"><h5>Work</h5><a href="/#expertise">Expertise</a><a href="/work/">Case Studies</a><a href="/sources/">Sources</a><a href="/tools/">Proprietary Tools</a></div>
      <div class="footer-col"><h5>Connect</h5><a href="{{ site.linkedin }}" target="_blank" rel="noopener">LinkedIn</a><a href="{{ site.github }}" target="_blank" rel="noopener">GitHub</a><a href="mailto:{{ site.authorEmail }}">Email</a></div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-copy">© 2026 Khadija Zaman · AI Search Manager · Karachi, Pakistan</div>
    <div class="footer-copy">Built to be ranked by search engines and cited by answer engines.</div>
  </div>
</footer>

<script src="/js/site.js" defer></script>
</body>
</html>

---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Khadija Zaman — SEO &amp; AI Search Field Notes</title>
    <link>{{ site.url }}/blog/</link>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml"/>
    <description>Practical writing on SEO, AI search visibility (GEO/AEO), semantic content strategy, and marketing automation.</description>
    <language>en</language>
    <managingEditor>{{ site.authorEmail }} (Khadija Zaman)</managingEditor>
    {%- for post in collections.posts %}
    <item>
      <title>{{ post.data.title }}</title>
      <link>{{ site.url }}{{ post.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
      <pubDate>{{ post.date | rssDate }}</pubDate>
      <category>{{ post.data.category }}</category>
      <description>{{ post.data.description }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>

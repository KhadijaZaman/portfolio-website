# khadijazaman.com — Apache/LiteSpeed config (Hostinger)

# ── Custom 404 (built from src/404.njk) ─────────────────────
ErrorDocument 404 /404.html

# ── Compression ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml \
    application/rss+xml image/svg+xml font/woff2 font/woff
</IfModule>

# ── Caching ──────────────────────────────────────────────────
# Unhashed CSS/JS get a short TTL so deploys show up quickly (still
# revalidated via ETag). Images/fonts cache longer. HTML always revalidates.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ── Security headers ───────────────────────────────────────
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "DENY"
  Header set Strict-Transport-Security "max-age=15768000"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ── Markdown twins (content negotiation) ────────────────────
# Every page has a markdown twin at <url>index.md, written at build time
# from the rendered page (scripts/markdown-twins.js). A request carrying
# "Accept: text/markdown" is rewritten to the twin internally, no redirect,
# so it cannot loop behind the CDN. /about.md also resolves to /about/index.md.
AddType text/markdown .md
AddCharset UTF-8 .md
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteCond %{REQUEST_URI} ^(.*/)$
  RewriteCond %{DOCUMENT_ROOT}%1index.md -f
  RewriteRule ^ %1index.md [L]
  RewriteCond %{REQUEST_URI} ^/([a-z0-9/_-]+)\.md$
  RewriteCond %{DOCUMENT_ROOT}/%1/index.md -f
  RewriteRule ^ /%1/index.md [L]
</IfModule>
<IfModule mod_headers.c>
  # Vary: Accept is set per page by the generated per-directory .htaccess
  # files ("Header append" was not honoured by the host; "set" is).
  <FilesMatch "\.md$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Note: HTTPS and www->non-www redirects are handled by Hostinger + CDN,
# so no redirect rules here (a duplicate rule can loop behind the CDN).

---
layout: base.njk
title: "Blog · SEO, AI Search & Automation Field Notes"
description: "Practical writing on SEO, AI search visibility (GEO/AEO), semantic content strategy, and marketing automation by Khadija Zaman."
permalink: /blog/index.html
---
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Khadija Zaman — Blog",
  "url": site.url + "/blog/",
  "author": { "@type": "Person", "name": "Khadija Zaman", "url": site.url + "/" }
} | dump | safe }}</script>
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": site.url + "/blog/" }
  ]
} | dump | safe }}</script>

<header class="page-hero">
  <div class="page-hero-orb" aria-hidden="true"></div>
  <div class="wrap">
    <nav class="crumbs reveal" aria-label="Breadcrumb"><a href="/">Home</a> <span>/</span> Blog</nav>
    <h1 class="reveal d1">Field notes on SEO &amp; AI search</h1>
    <p class="lead reveal d2">Practical breakdowns on ranking in Google, getting cited by ChatGPT, Gemini, and Perplexity, and the automations that make it repeatable.</p>
  </div>
</header>

<section aria-label="Articles">
  <div class="wrap">
    <h2 class="sr-only">Articles</h2>
    {% set hasStarter = false %}
    {% for post in collections.posts %}{% if post.data.starter %}{% set hasStarter = true %}{% endif %}{% endfor %}
    {% if hasStarter %}
    <div class="draft-note reveal" style="max-width:none;margin-bottom:2.5rem;">
      <span aria-hidden="true">✎</span>
      <div><strong>Starter posts.</strong> Posts marked with a starter banner are seeded drafts showing the template. Publish your own from the editor at <code>/admin</code> and they replace these automatically.</div>
    </div>
    {% endif %}

    <!-- Filter + search (progressively enhanced; all posts still render without JS) -->
    <div class="blog-filter reveal" id="blog-filter">
      <div class="blog-search">
        <input type="search" id="blog-search" placeholder="Search posts…" aria-label="Search posts" autocomplete="off">
      </div>
      <div class="chip-row" id="chip-row" role="tablist" aria-label="Filter by category">
        <button class="chip active" type="button" data-cat="all">All</button>
        {% for c in collections.categories %}
        <button class="chip" type="button" data-cat="{{ c.title }}">{{ c.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="post-grid" id="post-grid">
    {% for post in collections.posts %}
      <a class="post-card reveal{% if loop.index0 % 2 == 1 %} d1{% endif %}" href="{{ post.url }}"
         data-cat="{{ post.data.category }}"
         data-text="{{ (post.data.title + ' ' + post.data.description + ' ' + post.data.category) | lower }}">
        <div class="post-meta"><span class="post-cat">{{ post.data.category }}</span><span class="post-date">{{ post.data.date | readableDate }} · {{ post.data.readTime }}</span></div>
        <h3>{{ post.data.title }}</h3>
        <p>{{ post.data.description }}</p>
        <span class="post-more">Read the post →</span>
      </a>
    {% endfor %}
    </div>
    <p class="blog-empty" id="blog-empty" hidden>No posts match that search. <button type="button" class="blog-clear" id="blog-clear">Clear filters</button></p>

    <div class="blog-foot">
      <a href="/feed.xml" class="blog-rss">Subscribe via RSS</a>
    </div>
  </div>
</section>

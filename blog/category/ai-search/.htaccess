    Header set X-Markdown-Twin "/blog/category/ai-search/index.md; html-bytes=8723; md-bytes=1124; saved=7599"
    Header set Link '<https://khadijazaman.com/blog/category/ai-search/index.md>; rel="alternate"; type="text/markdown"'
    Header set Vary "Accept, Accept-Encoding"
  </Files>
  <Files "index.md">

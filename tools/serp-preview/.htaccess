# Generated by scripts/markdown-twins.js. Names the markdown twin, what it saved, and keeps it out of search indexes.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set X-Markdown-Twin "/tools/serp-preview/index.md; html-bytes=11932; md-bytes=1262; saved=10670"
    Header set Link '<https://khadijazaman.com/tools/serp-preview/index.md>; rel="alternate"; type="text/markdown"'
    Header set Vary "Accept, Accept-Encoding"
  </Files>
  <Files "index.md">
    Header set X-Markdown-Twin "generated-from-rendered-html; html-bytes=11932; md-bytes=1262; saved=10670"
    Header set Link '<https://khadijazaman.com/tools/serp-preview/>; rel="canonical"; type="text/html"'
    Header set Vary "Accept, Accept-Encoding"
    Header set X-Robots-Tag "noindex"
  </Files>
</IfModule>

# Generated by scripts/markdown-twins.js. Names the markdown twin, what it saved, and keeps it out of search indexes.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set X-Markdown-Twin "/tools/query-fan-out/index.md; html-bytes=14511; md-bytes=2242; saved=12269"
    Header set Link '<https://khadijazaman.com/tools/query-fan-out/index.md>; rel="alternate"; type="text/markdown"'
    Header set Vary "Accept, Accept-Encoding"
  </Files>
  <Files "index.md">
    Header set X-Markdown-Twin "generated-from-rendered-html; html-bytes=14511; md-bytes=2242; saved=12269"
    Header set Link '<https://khadijazaman.com/tools/query-fan-out/>; rel="canonical"; type="text/html"'
    Header set Vary "Accept, Accept-Encoding"
    Header set X-Robots-Tag "noindex"
  </Files>
</IfModule>

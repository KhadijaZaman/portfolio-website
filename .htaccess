# khadijazaman.com — Apache/LiteSpeed config (Hostinger)

# ── Custom 404 (built from src/404.njk) ─────────────────────
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# ── Spam URL patterns: answer 410 Gone ──────────────────────
# In May–June 2026 the server was injected with several hundred
# /x12345678901234.html and /items/R123456789/ pages. They are deleted;
# 410 tells Google to drop them faster than 404 and fails closed if the
# pattern is ever re-injected.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^[a-z][0-9]{14}\.html$ - [G,L]
  RewriteRule ^items/R[0-9]+/?$ - [G,L]
</IfModule>

# ── Moved pages: permanent redirects ────────────────────────
# Sep 2026 restructure: frameworks and research left the blog, and the four
# old blog categories became three. Each rule also covers the page's
# markdown twin (index.md) so Accept: text/markdown clients land right.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^blog/r2a-content-framework/?(index\.md)?$ /frameworks/r2a/$1 [R=301,L]
  RewriteRule ^blog/berap-map/?(index\.md)?$ /frameworks/r2a/berap/$1 [R=301,L]
  RewriteRule ^blog/breaking-my-own-study/?(index\.md)?$ /research/citation-study-retest/$1 [R=301,L]
  RewriteRule ^blog/category/ai-search/?$ /blog/category/foundations/ [R=301,L]
  RewriteRule ^blog/category/geo-aeo/?$ /blog/category/optimization/ [R=301,L]
  RewriteRule ^blog/category/content-strategy/?$ /blog/category/foundations/ [R=301,L]
  RewriteRule ^blog/category/frameworks/?$ /frameworks/ [R=301,L]
</IfModule>

# ── Compression ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml \
    application/rss+xml image/svg+xml font/woff2 font/woff
</IfModule>

# ── Caching ──────────────────────────────────────────────────
# Unhashed CSS/JS get a short TTL so deploys show up quickly (still
# revalidated via ETag). Images/fonts cache longer. HTML always revalidates.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ── Security headers ───────────────────────────────────────
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "DENY"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Content-Security-Policy: allows only this origin, Google Fonts, the
  # Cloudflare analytics beacon and Web3Forms, plus a hash for each inline
  # script in the built HTML. The line below is replaced on every build.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw=' 'sha256-woeUWDymItjzJ73VFF3sQBg2E+ixGv8I3MCsAqq37Hg=' 'sha256-5zoet9Bq1jXHqqBHIVuZ2bfSx5xYn+D59Iba07bMgdc=' 'sha256-1PcFLfqa2uN5pNqnPH9JcCQDpC0LG9wr5JBBdK0NfMw=' 'sha256-0zoAfsUjXDZb4QvjWCc8FH19tZVB/gaLK+cvRATZmD0=' 'sha256-BfxC74VqaXV4VQ2ICKUdBl/Prvp6AYKinh4h3cu4iG4=' 'sha256-KP74xkmg5L6hPbxNxW1LBNfmKmOxJ25sQGRiB6+8aZ4=' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc=' 'sha256-MguIPR6qNR8D3B+eAlK+bIRTZe8t3wkOY4B/56Me9FU=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com https://cloudflareinsights.com https://static.cloudflareinsights.com; form-action 'self' https://api.web3forms.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"
</IfModule>

# ── Markdown twins (content negotiation) ────────────────────
# Every page has a markdown twin at <url>index.md, written at build time
# from the rendered page (scripts/markdown-twins.js). A request carrying
# "Accept: text/markdown" is rewritten to the twin internally, no redirect,
# so it cannot loop behind the CDN. /about.md also resolves to /about/index.md.
AddType text/markdown .md
AddCharset UTF-8 .md
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteCond %{REQUEST_URI} ^(.*/)$
  RewriteCond %{DOCUMENT_ROOT}%1index.md -f
  RewriteRule ^ %1index.md [L]
  RewriteCond %{REQUEST_URI} ^/([a-z0-9/_-]+)\.md$
  RewriteCond %{DOCUMENT_ROOT}/%1/index.md -f
  RewriteRule ^ /%1/index.md [L]
</IfModule>
<IfModule mod_headers.c>
  # Vary: Accept is set per page by the generated per-directory .htaccess
  # files ("Header append" was not honoured by the host; "set" is).
  <FilesMatch "\.md$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Note: HTTPS and www->non-www redirects are handled by Hostinger + CDN,
# so no redirect rules here (a duplicate rule can loop behind the CDN).

# Generated by scripts/markdown-twins.js. Names the markdown twin, what it saved, and keeps it out of search indexes.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set X-Markdown-Twin "/index.md; html-bytes=63945; md-bytes=8069; saved=55876"
    Header set Link '<https://khadijazaman.com/index.md>; rel="alternate"; type="text/markdown"'
    Header set Vary "Accept, Accept-Encoding"
  </Files>
  <Files "index.md">
    Header set X-Markdown-Twin "generated-from-rendered-html; html-bytes=63945; md-bytes=8069; saved=55876"
    Header set Link '<https://khadijazaman.com/>; rel="canonical"; type="text/html"'
    Header set Vary "Accept, Accept-Encoding"
    Header set X-Robots-Tag "noindex"
  </Files>
</IfModule>
